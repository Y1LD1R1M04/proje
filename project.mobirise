        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "background": "@wrapBgColor",
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2.25rem"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "left"
            },
            ".card-title, .card-box": {
              "text-align": "center",
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "text-align": "left"
            },
            ".mbr-text": {
              "text-align": "left"
            },
            ".mbr-card-title": {
              "text-align": "left"
            },
            "P": {
              "color": "#ffffff"
            }
          },
          "_name": "list04",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list04\" group=\"List\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Content Width\" name=\"contentWidth\" min=\"8\" max=\"12\" step=\"1\" value=\"10\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n    <input type=\"checkbox\" title=\"Paragraph Title\" name=\"showTitle\" checked>\n    <input type=\"color\" title=\"Wrap Bg\" name=\"wrapBgColor\" value=\"#ffffff\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n      <input type=\"color\" title=\"Color\" value=\"#edefeb\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n      <div class=\"card col-md-12 col-lg-{{contentWidth}}\">\n        <div class=\"card-wrapper\">\n          <div class=\"row justify-content-center\">\n            <div class=\"col-12 mb-5 content-head\" mbr-if=\"showMainTitle || showMainSubtitle\">\n              <h3 class=\"card-title mbr-fonts-style mbr-white mt-3\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".card-title, .card-box\"><b>Kaynakça</b></h3>\n              <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n              </h5>\n            </div>\n          </div>\n\n          <div class=\"row justify-content-left item features-without-image mt-0 mb-5 active\">\n            <div class=\"col-12 col-md-12 col-lg-3\" mbr-if=\"showTitle\">\n              <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\"><b>Ana Sayfa</b></h5>\n            </div>\n            <div class=\"col-md-12 col-lg item-wrapper\">\n              <p class=\"mbr-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Ağrı Dağı Fotoğrafı:&nbsp;<a href=\"https://tr.wikipedia.org/wiki/Dosya:B%C3%BCy%C3%BCk_ve_K%C3%BC%C3%A7%C3%BCk_A%C4%9Fr%C4%B1_Da%C4%9F%C4%B1.jpg\" class=\"text-warning\" target=\"_blank\">https://tr.wikipedia.org/</a><br>Okulumuzun Fotoğrafları: <a href=\"https://www.google.com/maps/place/Sultanbeyli+Sabiha+G%C3%B6k%C3%A7en+Mesleki+ve+Teknik+Anadolu+Lisesi/@40.9867714,29.2667874,3a,75y,90t/data=!3m8!1e2!3m6!1sCIHM0ogKEICAgIDWn67VNg!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fgps-cs-s%2FAG0ilSxq8_mJDxU8FxsMTVfERSgxEIAX5yZE-P9r1KIbcQNRUPEZcVIDjN3-px-J8KU4mk87lFvcZnbd1CxOWc9SKUPUV0gKQNpbQPUAY2_gDMIBm7qZ1zJKP2E5-A5-21CtacZEfgnq%3Dw203-h270-k-no!7i3024!8i4032!4m9!3m8!1s0x14cad04d792bd8a1:0xe3ec7bffa05de64b!8m2!3d40.986715!4d29.2667909!10e5!14m1!1BCgIgAQ!16s%2Fg%2F113j308n1?entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoASAFQAw%3D%3D\" class=\"text-warning\" target=\"_blank\">https://google.com/maps/</a><a href=\"https://www.google.com/maps/place/Sultanbeyli+Sabiha+G%C3%B6k%C3%A7en+Mesleki+ve+Teknik+Anadolu+Lisesi/@40.9867714,29.2667874,3a,75y,90t/data=!3m8!1e2!3m6!1sCIHM0ogKEICAgIDWn67VNg!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fgps-cs-s%2FAG0ilSxq8_mJDxU8FxsMTVfERSgxEIAX5yZE-P9r1KIbcQNRUPEZcVIDjN3-px-J8KU4mk87lFvcZnbd1CxOWc9SKUPUV0gKQNpbQPUAY2_gDMIBm7qZ1zJKP2E5-A5-21CtacZEfgnq%3Dw203-h270-k-no!7i3024!8i4032!4m9!3m8!1s0x14cad04d792bd8a1:0xe3ec7bffa05de64b!8m2!3d40.986715!4d29.2667909!10e5!14m1!1BCgIgAQ!16s%2Fg%2F113j308n1?entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoASAFQAw%3D%3D\" class=\"text-primary\" target=\"_blank\"><br></a>&nbsp;<a href=\"https://www.google.com/maps/place/Sultanbeyli+Sabiha+G%C3%B6k%C3%A7en+Mesleki+ve+Teknik+Anadolu+Lisesi/@40.986715,29.2667909,3a,75y,90t/data=!3m8!1e2!3m6!1sCIHM0ogKEICAgIDMprnJwwE!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fgps-cs-s%2FAG0ilSxCnjifb6lFitr0VntIict4KcsufGr9TZ1RcOmzrODyw_2FWEZfy4kSo539ScegYJTdC8rVr1NuiWx-p94ZK4te7M8ggbu0LgLIgdUMmkdTSjcclimWKW7ERYqKPqCmxPLW_qRjKw%3Dw203-h151-k-no!7i1600!8i1194!4m9!3m8!1s0x14cad04d792bd8a1:0xe3ec7bffa05de64b!8m2!3d40.986715!4d29.2667909!10e5!14m1!1BCgIgAQ!16s%2Fg%2F113j308n1?entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoASAFQAw%3D%3D\" class=\"text-warning\" target=\"_blank\">https://google.com/maps/2/</a><br>Okulumuzun Tanıtım Videoları: <a href=\"https://youtu.be/2vj8rqf4ywo?si=6qLT92RumoypEm81\" class=\"text-warning\" target=\"_blank\">https://youtube.com/</a>&nbsp; <a href=\"https://youtu.be/_KXR2qL8lR0?si=r4db2Cr36ZC6tC9y\" class=\"text-warning\" target=\"_blank\">https://youtube.com/2/</a><br>Hakkında Bölümü:&nbsp;<a href=\"https://isgokcen.meb.k12.tr/tema/okulumuz_hakkinda.php\" class=\"text-warning\" target=\"_blank\">https://isgokcen.meb.k12.tr/</a><a href=\"https://www.google.com/maps/place/Sultanbeyli+Sabiha+G%C3%B6k%C3%A7en+Mesleki+ve+Teknik+Anadolu+Lisesi/@40.986715,29.2667909,3a,75y,90t/data=!3m8!1e2!3m6!1sCIHM0ogKEICAgIDMprnJwwE!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fgps-cs-s%2FAG0ilSxCnjifb6lFitr0VntIict4KcsufGr9TZ1RcOmzrODyw_2FWEZfy4kSo539ScegYJTdC8rVr1NuiWx-p94ZK4te7M8ggbu0LgLIgdUMmkdTSjcclimWKW7ERYqKPqCmxPLW_qRjKw%3Dw203-h151-k-no!7i1600!8i1194!4m9!3m8!1s0x14cad04d792bd8a1:0xe3ec7bffa05de64b!8m2!3d40.986715!4d29.2667909!10e5!14m1!1BCgIgAQ!16s%2Fg%2F113j308n1?entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoASAFQAw%3D%3D\" class=\"text-warning\" target=\"_blank\"><br></a></p>\n            </div>\n          </div>\n          \n          <div class=\"row justify-content-left item features-without-image mt-0 mb-5\">\n\n            <div class=\"col-12 col-md-12 col-lg-3 \" mbr-if=\"showTitle\">\n              <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\"><b>Yaşadığım Yer</b></h5>\n            </div>\n            <div class=\"col-md-12 col-lg\">\n              <p class=\"mbr-text mbr-fonts-style mt-0 mb-0 item-wrapper\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Sultanbeyli'nin Fotoğrafları: <a href=\"https://www.google.com/search?q=sultanbeyli&rlz=1C1GCEA_enTR1123TR1123&oq=sultanbeyli++&gs_lcrp=EgZjaHJvbWUqBggAEEUYOzIGCAAQRRg7MgYIARBFGDsyFQgCEC4YJxivARjHARiABBiKBRiOBTITCAMQLhivARjHARixAxiABBiOBTIGCAQQRRg8MgYIBRBFGDwyBggGEEUYPDIGCAcQRRg80gEINTg3MWowajSoAgCwAgE&sourceid=chrome&ie=UTF-8\" class=\"text-warning\" target=\"_blank\">https://google.com/</a>&nbsp;<a href=\"https://www.sultanbeyli.bel.tr/fotograflarla-sultanbeyli/\" class=\"text-warning\" target=\"_blank\">https://www.sultanbeyli.bel.tr/</a><br>Hakkında ve Tarihi Kısmının Esinlenildiği Yer: <a href=\"https://tr.wikipedia.org/wiki/Sultanbeyli\" class=\"text-warning\" target=\"_blank\">https://tr.wikipedia.org/</a><br></p><div class=\"item-menu-overlay\" style=\"opacity: 0.0820963;\"><div class=\"btn-wrapper\"><span class=\"mbr-icon-arrow-left ctrl-btn\"><span class=\"tooltiptext\">Move Left</span></span><span class=\"mbr-icon-arrow-right ctrl-btn\"><span class=\"tooltiptext\">Move Right</span></span><span class=\"mbr-icon-trash ctrl-btn\"><span class=\"tooltiptext\">Remove</span></span><span class=\"mbr-icon-plus ctrl-btn\"><span class=\"tooltiptext\">Add Copy</span></span></div></div><p></p>\n            </div>\n          </div><div class=\"row justify-content-left item features-without-image mt-0 mb-5\">\n\n            <div class=\"col-12 col-md-12 col-lg-3 \" mbr-if=\"showTitle\">\n              <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\"><b>Hakkımda</b></h5>\n            </div>\n            <div class=\"col-md-12 col-lg\">\n              <p class=\"mbr-text mbr-fonts-style mt-0 mb-0 item-wrapper\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">E-Okul Vesikalık Fotoğrafım:&nbsp;<a href=\"https://www.turkiye.gov.tr/ogrenci-bilgi-sistemi\" class=\"text-warning text-primary\" target=\"_blank\">https://e-okul.meb.gov.tr/</a><br></p><div class=\"item-menu-overlay\" style=\"opacity: 0.999938;\"><div class=\"btn-wrapper\"><span class=\"mbr-icon-arrow-left ctrl-btn\"><span class=\"tooltiptext\">Move Left</span></span><span class=\"mbr-icon-arrow-right ctrl-btn\"><span class=\"tooltiptext\">Move Right</span></span><span class=\"mbr-icon-trash ctrl-btn\"><span class=\"tooltiptext\">Remove</span></span><span class=\"mbr-icon-plus ctrl-btn\"><span class=\"tooltiptext\">Add Copy</span></span></div></div><p>a</p><div class=\"item-menu-overlay\" style=\"opacity: 1;\"><div class=\"btn-wrapper\"><span class=\"mbr-icon-arrow-left ctrl-btn\"><span class=\"tooltiptext\">Move Left</span></span><span class=\"mbr-icon-arrow-right ctrl-btn\"><span class=\"tooltiptext\">Move Right</span></span><span class=\"mbr-icon-trash ctrl-btn\"><span class=\"tooltiptext\">Remove</span></span><span class=\"mbr-icon-plus ctrl-btn\"><span class=\"tooltiptext\">Add Copy</span></span></div></div><p></p>\n            </div>\n          </div><div class=\"row justify-content-left item features-without-image mt-0 mb-5\">\n\n            <div class=\"col-12 col-md-12 col-lg-3 \" mbr-if=\"showTitle\">\n              <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\"><b>Staj Yerim</b></h5>\n            </div>\n            <div class=\"col-md-12 col-lg\">\n              <p class=\"mbr-text mbr-fonts-style mt-0 mb-0 item-wrapper\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Hakkında Kısmının Esinlenildiği Yer:&nbsp;<a href=\"https://www.sasad.org.tr/tci-kabin-ici-sistemleri-san-ve-tic-as\" class=\"text-warning\" target=\"_blank\">https://www.sasad.org.tr/</a><br>Logo: <a href=\"https://fi.linkedin.com/company/tci-aircraft-interiors?trk=public_profile_experience-item_profile-section-card_image-click\" class=\"text-warning\" target=\"_blank\">https://fi.linkedin.com/</a><br>Ürettiklerinin Fotoğrafı: <a href=\"https://haber.aero/yazarlar/guntay-simsek/turkiyenin-yeni-havacilik-teknoloji-ussu-tci/\" class=\"text-warning\" target=\"_blank\">https://haber.aero/</a></p><div class=\"item-menu-overlay\" style=\"opacity: 1;\"><div class=\"btn-wrapper\"><span class=\"mbr-icon-arrow-left ctrl-btn\"><span class=\"tooltiptext\">Move Left</span></span><span class=\"mbr-icon-arrow-right ctrl-btn\"><span class=\"tooltiptext\">Move Right</span></span><span class=\"mbr-icon-trash ctrl-btn\"><span class=\"tooltiptext\">Remove</span></span><span class=\"mbr-icon-plus ctrl-btn\"><span class=\"tooltiptext\">Add Copy</span></span></div></div><p>(TCI Aircraft Interiors)</p>\n            </div>\n          </div><div class=\"row justify-content-left item features-without-image mt-0 mb-5\">\n\n            <div class=\"col-12 col-md-12 col-lg-3 \" mbr-if=\"showTitle\">\n              <h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-7\"><b>Cihazlarım</b></h5>\n            </div>\n            <div class=\"col-md-12 col-lg\">\n              <p class=\"mbr-text mbr-fonts-style mt-0 mb-0 item-wrapper\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Telefonun Fotoğrafları: <a href=\"https://www.samsung.com/tr/smartphones/galaxy-a/galaxy-a55-5g-awesome-navy-128gb-sm-a556ezkvtur/?srsltid=AfmBOoosr5ndm7juBTzvouAhznkZ7-ZozWso6YszSj9u_raUZ_DeoJ25\" class=\"text-warning\" target=\"_blank\">https://samsung.com/tr/</a><br>Laptopun Fotoğrafı: <a href=\"https://www.vatanbilgisayar.com/lenovo-z5070-core-i7-4510u-20ghz-8gb-1tbsshdd-156-4gb-w81-notebook.html\" class=\"text-warning\" target=\"_blank\">https://vatanbilgisayar.com/</a><br>Laptopun Özelliklerinin Esinlenildiği Yer: <a href=\"https://www.epey.com/laptop/lenovo-z5070-59-432079.html\" class=\"text-warning\" target=\"_blank\">https://epey.com/</a><a href=\"https://www.samsung.com/tr/smartphones/galaxy-a/galaxy-a55-5g-awesome-navy-128gb-sm-a556ezkvtur/?srsltid=AfmBOoosr5ndm7juBTzvouAhznkZ7-ZozWso6YszSj9u_raUZ_DeoJ25\" class=\"text-warning\" target=\"_blank\"><br></a></p>\n            </div>\n          </div>\n\n\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
